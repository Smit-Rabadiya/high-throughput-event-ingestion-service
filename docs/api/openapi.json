{
  "openapi": "3.0.4",
  "info": {
    "title": "Event Ingestion Service",
    "description": "High-throughput IoT ingestion: POST batches of up to 50,000 readings, query exact rolling 5-minute\ncount / min / max / average per device.\n\n**Authentication** (when enabled, always in the Production profile): send \u0060X-Api-Key\u0060. Scopes: \u0060ingest\u0060 for POST,\n\u0060query\u0060 for GETs. Probes (\u0060/health\u0060, \u0060/health/ready\u0060, \u0060/version\u0060) are anonymous. In local development auth is off by default.\n\n**Timestamps** are ISO-8601 UTC; a value with no \u0060Z\u0060/offset is treated as UTC. Readings older than the window are \u0060stale\u0060,\nmore than 1 minute ahead are \u0060future\u0060; bad readings are skipped and counted as \u0060invalid\u0060.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/api/v1/readings": {
      "post": {
        "tags": [
          "Ingestion"
        ],
        "summary": "Ingest a batch of readings (up to 50,000)",
        "description": "Body: a JSON array of \u0060{deviceId, timestamp, value}\u0060. The body is streamed and each reading is applied as it is parsed.\nAlways 200 when the batch was processed, even if some readings were rejected: see \u0060rejected\u0060.\n400/413 mean parsing stopped early; readings before the error **stay applied** and \u0060accepted\u0060 says how many.\nSend \u0060Idempotency-Key\u0060 to make retries safe.",
        "operationId": "IngestReadings",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Optional. 1-128 printable ASCII chars identifying this exact batch. Retrying with the same key returns the original result (header \u0060Idempotent-Replayed: true\u0060) and applies nothing twice. Remembered for 15 minutes by default.",
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ReadingRequest"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/{deviceId}/aggregates": {
      "get": {
        "tags": [
          "Aggregates"
        ],
        "summary": "Rolling aggregates for a device",
        "description": "Count, min, max and average over readings with timestamp in (now - 5 min, now]. 404 means unknown device or no readings left in the window (see \u0060title\u0060).",
        "operationId": "GetDeviceAggregates",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceAggregatesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/aggregates": {
      "get": {
        "tags": [
          "Aggregates"
        ],
        "summary": "Rolling aggregates for a device (id in query string)",
        "description": "Identical to the path form; use it for ids containing \u0060/\u0060 or other path-hostile characters.",
        "operationId": "GetDeviceAggregatesByQuery",
        "parameters": [
          {
            "name": "deviceId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceAggregatesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Running version",
        "operationId": "GetVersion",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildInfo"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Liveness probe",
        "operationId": "GetLiveness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Readiness probe (503 while starting, recovering the journal, or shutting down)",
        "operationId": "GetReadiness",
        "responses": {
          "200": {
            "description": "OK"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BuildInfo": {
        "required": [
          "name",
          "version",
          "informationalVersion",
          "runtime"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "informationalVersion": {
            "type": "string"
          },
          "runtime": {
            "type": "string"
          }
        }
      },
      "DeviceAggregatesResponse": {
        "required": [
          "deviceId",
          "count",
          "min",
          "max",
          "average",
          "windowStart",
          "windowEnd"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int64"
          },
          "min": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "format": "double"
          },
          "max": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "format": "double"
          },
          "average": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "format": "double"
          },
          "windowStart": {
            "type": "string",
            "format": "date-time"
          },
          "windowEnd": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "IngestResponse": {
        "required": [
          "accepted",
          "rejected",
          "total"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "rejected": {
            "$ref": "#/components/schemas/RejectedCounts"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ReadingRequest": {
        "required": [
          "deviceId",
          "timestamp",
          "value"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
            "description": "Case-sensitive device id, 1-256 characters.",
            "example": "sensor-0042"
          },
          "timestamp": {
            "type": "string",
            "description": "ISO-8601, e.g. 2026-10-08T09:00:01Z (no Z/offset = UTC). Use a current time: readings 5 minutes or older are rejected as stale.",
            "format": "date-time"
          },
          "value": {
            "type": "number",
            "description": "Finite sensor reading (JSON number; strings, NaN and Infinity are invalid).",
            "format": "double",
            "example": 21.5
          }
        }
      },
      "RejectedCounts": {
        "required": [
          "stale",
          "future",
          "invalid",
          "deviceLimit"
        ],
        "type": "object",
        "properties": {
          "stale": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "future": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "invalid": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "deviceLimit": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "API key (required only when Auth:Enabled=true).",
        "name": "X-Api-Key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "ApiKey": []
    }
  ],
  "tags": [
    {
      "name": "Ingestion"
    },
    {
      "name": "Aggregates"
    },
    {
      "name": "Operations"
    }
  ]
}
