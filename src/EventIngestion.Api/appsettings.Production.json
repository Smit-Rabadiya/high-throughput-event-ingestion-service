{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true,
        "JsonWriterOptions": { "Indented": false }
      }
    }
  },
  "Auth": {
    "Enabled": true
  },
  "RateLimiting": {
    "Enabled": true
  },
  "Journal": {
    "Enabled": true,
    "Directory": "/var/lib/ingestion/journal",
    "Durability": "Fsync"
  }
}
