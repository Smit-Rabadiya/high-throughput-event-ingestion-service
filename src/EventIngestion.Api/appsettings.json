{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Window": {
    "Window": "00:05:00",
    "FutureSkewTolerance": "00:01:00",
    "MaxDevices": 100000
  },
  "Service": {
    "SweepInterval": "00:00:30",
    "MaxRequestBodyBytes": 33554432
  }
}
