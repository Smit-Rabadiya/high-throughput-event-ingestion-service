# Copy to .env (git-ignored) and fill in. Generate a key and its hash:
#   PowerShell:  $k = [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]]); $k
#                -join ([Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($k)) | % { $_.ToString("x2") })
#   bash:        k=$(openssl rand -base64 32); echo "$k"; printf %s "$k" | sha256sum
# Give the KEY to the client (header X-Api-Key); put only the HASH below.
INGEST_KEY_SHA256=
QUERY_KEY_SHA256=
GIT_SHA=
